{
  "name": "career-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "bun run prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "test": "bun test src",
    "test:unit": "bun test src",
    "e2e:db": "bash scripts/e2e-db.sh",
    "e2e:db:down": "docker compose -f docker-compose.e2e.yml down",
    "e2e": "bun run e2e:db && playwright test",
    "e2e:run": "playwright test",
    "predev": "bun scripts/copy-typst-wasm.mjs",
    "prebuild": "bun scripts/copy-typst-wasm.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.81",
    "@ai-sdk/openai-compatible": "^2.0.48",
    "@anthropic-ai/claude-agent-sdk": "^0.3.161",
    "@huggingface/transformers": "^4.2.0",
    "@mantine/core": "^9",
    "@mantine/dates": "^9",
    "@mantine/form": "^9",
    "@mantine/hooks": "^9",
    "@mantine/modals": "^9",
    "@mantine/notifications": "^9",
    "@myriaddreamin/typst-ts-node-compiler": "^0.7.0",
    "@myriaddreamin/typst-ts-renderer": "^0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "^0.7.0",
    "@myriaddreamin/typst.ts": "^0.7.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7",
    "ai": "^6.0.192",
    "better-auth": "^1.6.11",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "dotenv": "^17.4.2",
    "js-yaml": "^4.1.1",
    "lucide-react": "^1.17.0",
    "next": "16.2.6",
    "next-intl": "^4",
    "nodemailer": "^8.0.9",
    "pdfjs-dist": "^5.7.284",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "prisma": "^7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@playwright/test": "^1.60.0",
    "@types/bun": "^1.3.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "bun-types": "^1.3.14",
    "postcss": "^8.5.15",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "onnxruntime-node",
    "protobufjs",
    "sharp",
    "unrs-resolver"
  ]
