# Database
DATABASE_URL="postgres://career:dev-password@localhost:5432/career_hub"

# Auth
AUTH_ENABLED="false"
BETTER_AUTH_SECRET="dev-secret-replace-me-with-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:3000"
TRUSTED_ORIGINS="http://localhost:3000"

# SMTP (only required if AUTH_ENABLED=true)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="career-hub <noreply@example.com>"

# i18n
DEFAULT_LOCALE="fr"

# Seed
SEED_PERSONALITY_FILE="./Perosnality.md"
BOOTSTRAP_ADMIN_EMAIL="jdoe@tld.com"

# Storage
STORAGE_PATH="./storage"

# LLM defaults (overridable per-user via UI)
DEFAULT_LLM_MODE="local"

# Background job queue
JOB_MAX_ATTEMPTS=2
JOB_POLL_INTERVAL_MS=2000
